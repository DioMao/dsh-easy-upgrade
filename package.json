{
  "name": "dsh-easy-upgrade",
  "version": "0.2.3",
  "description": "DSH web plugin: check the local harness repo against origin/<branch> and one-click upgrade (stop dsh, reset --hard, install, build, restart). · DSH 一键升级：检查本地仓库与远程主分支差异，侧栏设置上方显示版本/更新按钮，点击一键升级并重启服务。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DioMao/dsh-easy-upgrade.git"
  },
  "homepage": "https://github.com/DioMao/dsh-easy-upgrade#readme",
  "bugs": {
    "url": "https://github.com/DioMao/dsh-easy-upgrade/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/run-harness-bin.mjs oxlint",
    "lint:fix": "node scripts/run-harness-bin.mjs oxlint --fix",
    "test": "node scripts/run-harness-bin.mjs vitest run",
    "test:watch": "node scripts/run-harness-bin.mjs vitest",
    "test:bundle": "node scripts/bundle-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "echo 'Not available: this standalone package is transpiled against the selected DeepSeek Harness checkout.'"
  },
  "devDependencies": {
    "oxlint": "^1.76.0",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "upgrade"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT"
}
