{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "docs/**"
  ],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-undef": "error",
    "no-redeclare": "error",
    "no-debugger": "error",
    "no-unreachable": "error",
    "no-constant-condition": "error",
    "no-unused-expressions": "error",
    "prefer-spread": "error",
    "prefer-rest-params": "error",
    "no-array-constructor": "error",
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ],
      "rules": {
        "typescript/no-explicit-any": "error",
        "typescript/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_"
          }
        ]
      },
      "plugins": [
        "typescript"
      ]
    },
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-unused-vars": "off",
        "typescript/no-unused-vars": "off"
      }
    }
  ]
}
